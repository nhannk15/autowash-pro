MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=autowashpro
MYSQL_USER=autowash
MYSQL_PASSWORD=change-me-db-password

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/autowashpro?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=autowash
SPRING_DATASOURCE_PASSWORD=change-me-db-password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

JWT_SECRET_KEY=change-me-minimum-64-random-chars
FRONTEND_BASE_URL=https://autowashpro.io.vn

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change-me@example.com
SPRING_MAIL_PASSWORD=change-me-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
EMAIL_SENDBOOKING=yes

GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

VNPAY_TMN_CODE=change-me
VNPAY_HASH_SECRET=change-me
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://autowashpro.io.vn/api/payment/vnpay/return
VNPAY_IPN_URL=https://autowashpro.io.vn/api/payment/vnpay/return
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURR_CODE=VND
VNPAY_LOCALE=vn

MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

